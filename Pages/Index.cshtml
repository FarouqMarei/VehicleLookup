@page
@model IndexModel
@{
    ViewData["Title"] = "Vehicle lookup";
}

<div class="lookup-panel">
    <h1>Find models by make and year</h1>
    <p class="lead">Pick a manufacturer, model year, and body type to list matching vehicles from the NHTSA database.</p>

    <div class="row g-3 filters">
        <div class="col-md-4">
            <label for="makeSelect" class="form-label">Make</label>
            <input type="text" id="makeFilter" class="form-control form-control-sm mb-1" placeholder="Filter makes..." />
            <select id="makeSelect" class="form-select" size="8">
                <option value="">Loading makes...</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="yearSelect" class="form-label">Model year</label>
            <select id="yearSelect" class="form-select">
                <option value="">Select year</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="typeSelect" class="form-label">Vehicle type</label>
            <select id="typeSelect" class="form-select" disabled>
                <option value="">Choose a make first</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="button" id="searchBtn" class="btn btn-primary" disabled>Search models</button>
        <span id="statusText" class="ms-2 text-muted"></span>
    </div>

    <div class="mt-4">
        <h2 class="h5">Results</h2>
        <ul id="modelList" class="list-group model-list"></ul>
    </div>
</div>
